# Αντιγράψτε αυτό το αρχείο σε «.env» και συμπληρώστε τις τιμές.
# Το .env ΔΕΝ ανεβαίνει ποτέ στο GitHub (είναι στο .gitignore).
# Στο Netlify οι ίδιες μεταβλητές μπαίνουν από: Site configuration → Environment variables.

# Το domain του site (για canonical, sitemap, Open Graph)
SITE_URL=https://www.example.gr

# Κράτηση: demo (δεν στέλνει τίποτα) ή live (Google Calendar)
PUBLIC_BOOKING_MODE=demo

# --- Google Calendar (μόνο για live). Οδηγίες στο README. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Το συμπληρώνει αυτόματα το: npm run google:auth
GOOGLE_REFRESH_TOKEN=
# ID ημερολογίου με τα blocks διαθεσιμότητας (π.χ. abc123@group.calendar.google.com)
GOOGLE_CALENDAR_AVAILABILITY_ID=
# ID ημερολογίου όπου γράφονται οι κρατήσεις (αν μείνει κενό: το κύριο ημερολόγιο)
GOOGLE_CALENDAR_BOOKINGS_ID=
# Ημερολόγια που «πιάνουν» χρόνο, χωρισμένα με κόμμα (προεπιλογή: primary)
GOOGLE_CALENDAR_BUSY_IDS=primary

# --- Προαιρετικά ---
# Στατιστικά χωρίς cookies (Plausible): το domain όπως το δηλώσατε στο Plausible
PUBLIC_PLAUSIBLE_DOMAIN=
# Επαλήθευση Google Search Console (μόνο ο κωδικός από το meta tag)
PUBLIC_GOOGLE_SITE_VERIFICATION=
